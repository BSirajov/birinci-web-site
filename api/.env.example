SECRET_KEY=change-me-in-production-use-a-long-random-string
DEBUG=true
APP_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:8088

# Local development (default):
DATABASE_URL=sqlite:///./var/birinci.db

# Production — Hostinger MySQL / MariaDB (from hPanel → Databases):
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DBNAME?charset=utf8mb4

COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_DAYS=30
ADMIN_EMAIL=

# --- Production example (VPS / Hostinger API host; never commit real secrets) ---
# APP_ENV=production
# SECRET_KEY=  # openssl rand -hex 32
# DEBUG=false
# PUBLIC_BASE_URL=https://birinci.cloud
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DBNAME?charset=utf8mb4
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# SESSION_DAYS=30
# ADMIN_EMAIL=you@example.com
#
# With APP_ENV=production the API refuses to start if SECRET_KEY is weak/default,
# DEBUG is true, COOKIE_SECURE is false, PUBLIC_BASE_URL is not https public,
# or DATABASE_URL is still SQLite.
